# Required in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=
# Set to 1 only when the public site is served over HTTPS.
SESSION_COOKIE_SECURE=1
# Request, individual photo, backup and log-retention limits (adjust to available persistent disk).
MAX_REQUEST_MB=1024
MAX_PHOTO_MB=10
MAX_BACKUP_MB=1024
ACTIVITY_LOG_MAX_MB=10
ACTIVITY_LOG_ROTATIONS=5

# Google service account JSON downloaded from Google Cloud (keep this file private).
# Relative paths are resolved from this project's app.py directory.
GOOGLE_CREDENTIALS_FILE=secrets/google-service-account.json
# Spreadsheet ID from the Google Sheet URL
GOOGLE_SHEET_ID=1G00qJaYGAKn49TtaNHbPwArFAkCpfUkgoEOze7LHx4g
# Existing Google Drive folder containing uploaded student photos
GOOGLE_PHOTO_FOLDER_ID=1nib4js7EkrszgAU-vtRl-TD0ZtviZhNz
# Optional sheet/tab name or A1 range. Leave empty to detect the Form response tab.
GOOGLE_SHEET_RANGE=
